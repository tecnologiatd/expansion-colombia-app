# App Expo. EXPO_PUBLIC_* se incluye en el binario: NUNCA guardar secretos aquí.

# 1. API del backend
# Desarrollo en dispositivo físico: IP de tu equipo en la red local.
EXPO_PUBLIC_BACKEND_URL=http://TU_DIRECCION_IP:3000
# Producción: URL HTTPS pública de Nest, no la URL de WordPress.
# ATENCIÓN: eas.json fija esta variable para preview y production. Revisar allí
# antes de construir: preview actualmente apunta al backend de producción.

# 2. Sentry en ejecución (opcional; sin DSN no se envían eventos)
# El DSN es público. El código también desactiva Sentry cuando __DEV__ es true.
EXPO_PUBLIC_SENTRY_DSN=
# Opcional localmente; preview/production lo fijan en eas.json.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

# 3. Sentry SOLO durante el build: token privado para subir source maps
# Configurar SENTRY_AUTH_TOKEN como secreto en EAS/CI; no versionarlo.
SENTRY_AUTH_TOKEN=
# app.config.js lee estos nombres para el plugin, con fallback a app.json.
SENTRY_ORG=atd-sas
SENTRY_PROJECT=expancol

# No añadir claves WooCommerce, Openpay, JWT_SECRET o PAYMENT_BRIDGE_SECRET.
# Resumen: ../expansion-colombia-backend/docs/RESUMEN_ESTADO_ACTUAL.md
