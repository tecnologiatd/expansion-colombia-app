EXPO_PUBLIC_BACKEND_URL=http://TU_DIRECCION_IP:3000

# --- Sentry ---
# DSN de runtime. Opcional en desarrollo; requerido en builds de produccion.
EXPO_PUBLIC_SENTRY_DSN=

# Token para subir source maps en builds. Generar en Sentry > Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=atd-sas
SENTRY_PROJECT=expancol
